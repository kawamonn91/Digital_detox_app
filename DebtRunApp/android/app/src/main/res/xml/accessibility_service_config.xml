<?xml version="1.0" encoding="utf-8"?>
<!--
  ScrollTrackerService の設定。対象アプリ(TrackedApps.kt と同じ一覧)から、次の2種類のイベントだけを受け取る。
    - スクロール(typeViewScrolled): スクロール量を記録する
    - 内容の変更(typeWindowContentChanged): YouTube ショートの動画の切り替わりを数えるためだけに使う(ShortsPageDetector)
  画面の文字などは読み取らない(canRetrieveWindowContent = false。イベントの種類とビューのクラス名しか使わない)。
-->
<accessibility-service
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeViewScrolled|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault"
    android:canRetrieveWindowContent="false"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="100"
    android:packageNames="com.instagram.android,com.instagram.barcelona,com.twitter.android,com.zhiliaoapp.musically,com.ss.android.ugc.trill,com.google.android.youtube,com.facebook.katana,com.reddit.frontpage,com.pinterest,com.snapchat.android" />
